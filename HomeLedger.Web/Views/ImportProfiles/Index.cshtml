@model IEnumerable<HomeLedger.Core.Entities.ImportProfile>
@{
    ViewData["Title"] = "Import profiles";
    var entityId = ViewBag.EntityId as int?;
}

<div class="page-head">
    <div>
        <h1>Import skip profiles</h1>
        <p class="page-subtitle">Per-entity rules for skipping transfers, card payments, and other non-expense rows during import.</p>
    </div>
    <div class="page-head-actions">
        <a role="button" asp-action="Create" asp-route-entityId="@entityId">
            <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg> New profile
        </a>
        @if (entityId is not null)
        {
            <form asp-action="CreateRbcTemplate" method="post" class="row-actions-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="entityId" value="@entityId" />
                <button type="submit" class="secondary">Add RBC chequing template</button>
            </form>
        }
    </div>
</div>

<form method="get" asp-action="Index" class="toolbar">
    <label>
        Entity
        <select name="entityId" onchange="this.form.submit()">
            <option value="">All entities</option>
            @foreach (var entity in (SelectList)ViewBag.Entities)
            {
                <option value="@entity.Value" selected="@(entityId?.ToString() == entity.Value)">@entity.Text</option>
            }
        </select>
    </label>
</form>

@if (!Model.Any())
{
    <p class="empty-state">No import profiles yet. Create one or use the RBC template for common Canadian bank CSV patterns.</p>
}
else
{
    <table class="table-narrow">
        <thead>
            <tr>
                <th>Entity</th>
                <th>Profile</th>
                <th class="num">Rules</th>
                <th>Default</th>
                <th>LLM for unmatched</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in Model)
            {
                <tr>
                    <td>@profile.LedgerEntity?.Name</td>
                    <td>@profile.Name</td>
                    <td class="num">@profile.Rules.Count(r => r.IsActive)</td>
                    <td>@(profile.IsDefault ? "Yes" : "")</td>
                    <td>@(profile.UseLlmForUnmatched ? "Yes" : "No")</td>
                    <td class="actions-cell">
                        @{
                            ViewData["EditUrl"] = Url.Action("Edit", new { id = profile.Id });
                            ViewData["DeleteUrl"] = null;
                        }
                        <partial name="_RowActions" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
