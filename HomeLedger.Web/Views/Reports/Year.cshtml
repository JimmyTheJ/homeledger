@model HomeLedger.Web.Models.YearlyReportViewModel
@{
    ViewData["Title"] = $"{Model.Year} Summary";
}

<div class="page-head">
    <div>
        <h1>@Model.Year yearly summary</h1>
        <p class="page-subtitle">Roll-up across all months</p>
    </div>
</div>

<nav class="report-tabs">
    <a asp-action="Spreadsheet" asp-route-year="@Model.Year" asp-route-entityId="@Model.LedgerEntityId">Spreadsheet</a>
    <a asp-action="Month" asp-route-year="@Model.Year" asp-route-entityId="@Model.LedgerEntityId">By day</a>
    <a asp-controller="Home" asp-action="Index" asp-route-year="@Model.Year" asp-route-entityId="@Model.LedgerEntityId">Dashboard</a>
    <strong>Year summary</strong>
</nav>

<form method="get" class="toolbar">
    <label>
        Year
        <input type="number" name="year" value="@Model.Year" min="2000" max="2100" />
    </label>
    <label>
        Entity
        <select name="entityId">
            <option value="">All</option>
            @foreach (var entity in Model.Entities)
            {
                <option value="@entity.Id" selected="@(Model.LedgerEntityId == entity.Id)">@entity.Name</option>
            }
        </select>
    </label>
    <button type="submit">Apply</button>
</form>

<div class="summary-cards">
    <article class="summary-card income">
        <span class="summary-label">Total income</span>
        <strong>@Model.Summary.TotalIncome.ToString("C")</strong>
    </article>
    <article class="summary-card expense">
        <span class="summary-label">Total expenses</span>
        <strong>@Model.Summary.TotalExpenses.ToString("C")</strong>
    </article>
    <article class="summary-card @(Model.Summary.Net >= 0 ? "positive" : "negative")">
        <span class="summary-label">Net</span>
        <strong>@Model.Summary.Net.ToString("C")</strong>
    </article>
</div>

<section>
    <h2>By month</h2>
    <figure class="table-narrow">
        <table class="year-grid">
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="num">Income</th>
                    <th class="num">Expenses</th>
                    <th class="num">Net</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var month in Model.Summary.ByMonth)
                {
                    <tr class="@(month.Net < 0 ? "negative-row" : "")">
                        <td>@month.MonthName</td>
                        <td class="num positive">@month.Income.ToString("C")</td>
                        <td class="num negative">@month.Expenses.ToString("C")</td>
                        <td class="num">@month.Net.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Total</th>
                    <th class="num positive">@Model.Summary.TotalIncome.ToString("C")</th>
                    <th class="num negative">@Model.Summary.TotalExpenses.ToString("C")</th>
                    <th class="num">@Model.Summary.Net.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </figure>
</section>

<section>
    <h2>By category (full year)</h2>
    <figure class="table-narrow">
        <table>
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Category</th>
                    <th class="num">Amount</th>
                    <th class="num">% of income</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Summary.ByCategory)
                {
                    var pctClass = row.IsIncome ? "" : row.PercentOfIncome switch
                    {
                        >= 20 => "danger",
                        >= 10 => "warning",
                        _ => "ok"
                    };
                    <tr class="@pctClass">
                        <td class="muted">@row.GroupName</td>
                        <td>@row.CategoryName</td>
                        <td class="num @(row.Total >= 0 ? "positive" : "negative")">@row.Total.ToString("C")</td>
                        <td class="num">@(row.IsIncome ? "—" : row.PercentOfIncome.ToString("F1") + "%")</td>
                    </tr>
                }
            </tbody>
        </table>
    </figure>
</section>
