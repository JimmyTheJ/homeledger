@model HomeLedger.Web.Models.MonthReportViewModel
@using HomeLedger.Core.Utilities
@using HomeLedger.Infrastructure.Services
@{
    ViewData["Title"] = $"{Model.MonthName} {Model.Year} — by day";
    var report = (MonthlyByDayReport)ViewBag.Report;
}

<div class="page-head">
    <div>
        <h1>@Model.MonthName @Model.Year</h1>
        <p class="page-subtitle">Transactions grouped by day</p>
    </div>
    <div class="page-head-actions">
        <a role="button" asp-controller="Transactions" asp-action="Create">
            <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg> Add
        </a>
    </div>
</div>

<nav class="report-tabs">
    <a asp-action="Spreadsheet" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-entityId="@Model.LedgerEntityId">Spreadsheet</a>
    <strong>By day</strong>
    <a asp-controller="Home" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-entityId="@Model.LedgerEntityId">Dashboard</a>
    <a asp-action="Year" asp-route-year="@Model.Year" asp-route-entityId="@Model.LedgerEntityId">Year summary</a>
</nav>

@{
    ViewData["FilterAction"] = "Month";
}
<partial name="_MonthPeriodFilter" model="Model" />

<div class="summary-strip">
    <span class="positive">Income @report.TotalIncome.ToString("C")</span>
    <span class="negative">Expenses @report.TotalExpenses.ToString("C")</span>
    <span class="@(report.Net >= 0 ? "positive" : "negative")">Net @report.Net.ToString("C")</span>
</div>

@if (!report.Days.Any())
{
    <p class="empty-state">No transactions this month.</p>
}
else
{
    <table class="day-table">
        <thead>
            <tr>
                <th class="cat-cell">Category</th>
                <th class="entity-cell">Entity</th>
                <th class="num">Amount</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        @foreach (var day in report.Days)
        {
            <tbody class="day-group">
                <tr class="day-header">
                    <th colspan="5">
                        @HomeLedgerFormats.FormatDate(day.Date)
                        <span class="positive">+@day.DayIncome.ToString("C")</span>
                        <span class="negative">−@day.DayExpenses.ToString("C")</span>
                    </th>
                </tr>
                @foreach (var tx in day.Transactions)
                {
                    <tr>
                        <td class="cat-cell">
                            <small class="muted">@tx.GroupName</small>
                            @tx.CategoryName
                        </td>
                        <td class="entity-cell">@tx.EntityName</td>
                        <td class="num @(tx.Amount >= 0 ? "positive" : "negative")">@tx.Amount.ToString("C")</td>
                        <td class="notes-cell">@(string.IsNullOrWhiteSpace(tx.Notes) ? "—" : tx.Notes)</td>
                        <td class="actions-cell">
                            @{
                                ViewData["EditUrl"] = Url.Action("Edit", "Transactions", new { id = tx.Id });
                                ViewData["DeleteUrl"] = null;
                            }
                            <partial name="_RowActions" />
                        </td>
                    </tr>
                }
            </tbody>
        }
    </table>
}
