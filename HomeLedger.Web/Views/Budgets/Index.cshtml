@model IEnumerable<HomeLedger.Core.Entities.BudgetLimit>
@{
    ViewData["Title"] = "Budgets";
    var statuses = ViewBag.Statuses as IReadOnlyList<HomeLedger.Infrastructure.Services.BudgetStatus> ?? [];
    var entities = ViewBag.Entities as IEnumerable<HomeLedger.Core.Entities.LedgerEntity> ?? [];
}

<div class="page-head">
    <div>
        <h1>Budget limits</h1>
    </div>
    <div class="page-head-actions">
        <a role="button" asp-action="Create">
            <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg> Add limit
        </a>
    </div>
</div>

<form method="get" class="toolbar">
    <label>
        Entity
        <select name="entityId">
            <option value="">All</option>
            @foreach (var entity in entities)
            {
                <option value="@entity.Id" selected="@(ViewBag.EntityId as int? == entity.Id)">@entity.Name</option>
            }
        </select>
    </label>
    <button type="submit">Filter</button>
</form>

@if (statuses.Any())
{
    <section>
        <h2>Current period</h2>
        <table class="table-narrow">
            <thead>
                <tr>
                    <th>Category</th>
                    <th class="num">Spent</th>
                    <th class="num">Limit</th>
                    <th class="num">Used</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in statuses)
                {
                    <tr class="@(s.IsOverBudget ? "danger" : s.IsWarning ? "warning" : "")">
                        <td>@s.Limit.Category.Name</td>
                        <td class="num">@s.Spent.ToString("C")</td>
                        <td class="num">@s.Limit.LimitAmount.ToString("C") (@s.Limit.Period)</td>
                        <td class="num">@s.PercentUsed.ToString("F0")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<section>
    <h2>Configured limits</h2>
    <table class="table-narrow">
        <thead>
            <tr>
                <th>Category</th>
                <th>Entity</th>
                <th class="num">Limit</th>
                <th>Period</th>
                <th class="num">Warning at</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var limit in Model)
            {
                <tr>
                    <td>@limit.Category.Name</td>
                    <td>@(limit.LedgerEntity?.Name ?? "All")</td>
                    <td class="num">@limit.LimitAmount.ToString("C")</td>
                    <td>@limit.Period</td>
                    <td class="num">@limit.WarningThresholdPercent%</td>
                    <td class="actions-cell">
                        @{
                            ViewData["EditUrl"] = null;
                            ViewData["DeleteUrl"] = Url.Action("Delete", new { id = limit.Id });
                            ViewData["DeleteLabel"] = "Remove limit";
                            ViewData["DeleteConfirm"] = "Remove this budget limit?";
                            ViewData["UseHtmxDelete"] = false;
                        }
                        <partial name="_RowActions" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
