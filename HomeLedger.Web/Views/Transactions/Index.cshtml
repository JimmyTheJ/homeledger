@model IEnumerable<HomeLedger.Core.Entities.Transaction>
@using HomeLedger.Core.Entities
@{
    ViewData["Title"] = "Transactions";
    var showSuperseded = ViewBag.ShowSuperseded as bool? ?? false;
    var transactions = Model.ToList();
}

<div class="page-head">
    <div>
        <h1>Transactions</h1>
        <p class="page-subtitle">@transactions.Count entr@(transactions.Count == 1 ? "y" : "ies")</p>
    </div>
    <div class="page-head-actions">
        <a role="button" asp-action="Create">
            <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg> Add transaction
        </a>
    </div>
</div>

<form method="get" class="toolbar">
    <label>
        From
        <input type="text" name="from" value="@(ViewBag.From is DateOnly from ? HomeLedgerFormats.FormatDate(from) : ViewBag.From)" placeholder="yyyy/MM/dd" />
    </label>
    <label>
        To
        <input type="text" name="to" value="@(ViewBag.To is DateOnly to ? HomeLedgerFormats.FormatDate(to) : ViewBag.To)" placeholder="yyyy/MM/dd" />
    </label>
    <label>
        Category
        <select name="categoryId" asp-items="ViewBag.Categories">
            <option value="">All</option>
        </select>
    </label>
    <label>
        Entity
        <select name="entityId" asp-items="ViewBag.Entities">
            <option value="">All</option>
        </select>
    </label>
    <label class="toolbar-check" title="Bank entries replaced by a more detailed receipt import.">
        <input type="checkbox" name="showSuperseded" value="true" @(showSuperseded ? "checked" : null) />
        Show superseded
    </label>
    <button type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-filter"></use></svg> Filter
    </button>
    <a role="button" class="secondary outline" asp-action="Index">Reset</a>
</form>

@if (transactions.Count == 0)
{
    <p class="empty-state">No transactions match these filters.</p>
}
else
{
    <form id="bulk-form" method="post" asp-action="BulkDelete"
          onsubmit="return confirm('Delete the selected transactions? Receipts will also delete their line items.');"></form>

    <figure>
        <table class="tx-table">
            <thead>
                <tr>
                    <th class="select-cell">
                        <input type="checkbox" data-select-all aria-label="Select all transactions" />
                    </th>
                    <th class="date-cell">Date</th>
                    <th class="cat-cell">Category</th>
                    <th class="entity-cell">Entity</th>
                    <th class="num">Amount</th>
                    <th>Merchant / Notes</th>
                    <th></th>
                </tr>
            </thead>
            @foreach (var t in transactions)
            {
                <partial name="_TransactionRow" model="t" />
            }
        </table>
    </figure>

    <div class="bulk-bar" id="bulk-bar" hidden>
        <span class="bulk-count" data-bulk-count>0 selected</span>
        <button type="submit" form="bulk-form" class="secondary">
            <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg> Delete selected
        </button>
        <button type="button" class="outline secondary" data-bulk-clear>Clear selection</button>
    </div>
}
