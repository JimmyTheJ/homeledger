@model IEnumerable<HomeLedger.Core.Entities.Transaction>
@using HomeLedger.Core.Entities
@{
    ViewData["Title"] = "Transactions";
    var showSuperseded = ViewBag.ShowSuperseded as bool? ?? false;
}

<hgroup>
    <h1>Transactions</h1>
    <p><a role="button" asp-action="Create">Add transaction</a></p>
</hgroup>

<form method="get" class="grid">
    <label>From <input type="text" name="from" value="@(ViewBag.From is DateOnly from ? HomeLedgerFormats.FormatDate(from) : ViewBag.From)" placeholder="yyyy/MM/dd" /></label>
    <label>To <input type="text" name="to" value="@(ViewBag.To is DateOnly to ? HomeLedgerFormats.FormatDate(to) : ViewBag.To)" placeholder="yyyy/MM/dd" /></label>
    <label>
        Category
        <select name="categoryId" asp-items="ViewBag.Categories">
            <option value="">All</option>
        </select>
    </label>
    <label>
        Entity
        <select name="entityId" asp-items="ViewBag.Entities">
            <option value="">All</option>
        </select>
    </label>
    <label>
        <input type="checkbox" name="showSuperseded" value="true" @(showSuperseded ? "checked" : null) />
        Show superseded
        <small>Bank entries replaced by a more detailed receipt import.</small>
    </label>
    <button type="submit">Filter</button>
</form>

<figure>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Entity</th>
                <th>Amount</th>
                <th>Merchant / Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="transaction-rows">
            @foreach (var t in Model)
            {
                <partial name="_TransactionRow" model="t" />
            }
        </tbody>
    </table>
</figure>
