@model HomeLedger.Core.Entities.Transaction
@using HomeLedger.Core.Utilities
@using HomeLedger.Core.Entities
@{
    var segments = NotesFormatter.ParseSegments(Model.Notes ?? "");
    var isSuperseded = Model.SupersededByTransactionId is not null;
    var isReceipt = Model.Kind == TransactionKind.Receipt;
    var groupId = $"tx-{Model.Id}";

    ViewData["EditUrl"] = isReceipt ? null : Url.Action("Edit", "Transactions", new { id = Model.Id });
    ViewData["DeleteUrl"] = Url.Action("Delete", "Transactions", new { id = Model.Id });
    ViewData["DeleteConfirm"] = isReceipt
        ? "Delete this receipt and all of its line items?"
        : "Delete this transaction?";
    ViewData["UseHtmxDelete"] = true;
    ViewData["HtmxTarget"] = "closest tbody";
}

<tbody class="tx-group" id="@groupId">
    <tr class="@(isSuperseded ? "inactive-row" : "")">
        <td class="select-cell">
            <input type="checkbox" name="ids" value="@Model.Id" form="bulk-form"
                   data-row-select aria-label="Select transaction on @HomeLedgerFormats.FormatDate(Model.Date)" />
        </td>
        <td class="date-cell">@HomeLedgerFormats.FormatDate(Model.Date)</td>
        <td class="cat-cell">
            @if (isReceipt)
            {
                <button type="button" class="receipt-toggle" data-receipt-toggle aria-expanded="false" aria-controls="@groupId">
                    <svg class="icon" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                    Receipt
                    <span class="line-count">@Model.LineItems.Count items</span>
                </button>
            }
            else
            {
                @Model.Category?.Name
            }
        </td>
        <td class="entity-cell">@Model.LedgerEntity?.Name</td>
        <td class="num @(Model.Amount >= 0 ? "positive" : "negative")">@Model.Amount.ToString("C")</td>
        <td class="notes-cell">
            @if (!string.IsNullOrWhiteSpace(Model.Merchant))
            {
                <span class="merchant-tag">@Model.Merchant</span>
            }
            @if (isSuperseded)
            {
                <span class="merchant-tag">Superseded by #@Model.SupersededByTransactionId</span>
            }
            @if (string.IsNullOrWhiteSpace(Model.Notes))
            {
                @if (string.IsNullOrWhiteSpace(Model.Merchant) && !isSuperseded)
                {
                    <span class="muted">—</span>
                }
            }
            else if (segments.Count <= 1)
            {
                @Model.Notes
            }
            else
            {
                <ul class="note-segments">
                    @foreach (var segment in segments)
                    {
                        <li>@segment</li>
                    }
                </ul>
            }
        </td>
        <td class="actions-cell">
            <partial name="_RowActions" />
        </td>
    </tr>

    @if (isReceipt)
    {
        foreach (var line in Model.LineItems.OrderBy(l => l.Id))
        {
            var measure = QuantityUnits.FormatSummary(line.Quantity, line.QuantityUnit, line.UnitPrice);
            <tr class="receipt-line-row" hidden>
                <td class="select-cell"></td>
                <td class="date-cell"></td>
                <td class="cat-cell line-category">@line.Category?.Name</td>
                <td class="entity-cell">@line.LedgerEntity?.Name</td>
                <td class="num @(line.Amount >= 0 ? "positive" : "negative")">@line.Amount.ToString("C")</td>
                <td class="notes-cell">
                    @(line.Notes ?? "—")
                    @if (!string.IsNullOrWhiteSpace(measure))
                    {
                        <br />
                        <small>@measure</small>
                    }
                </td>
                <td class="actions-cell">
                    @{
                        ViewData["EditUrl"] = Url.Action("Edit", "Transactions", new { id = line.Id });
                        ViewData["DeleteUrl"] = Url.Action("Delete", "Transactions", new { id = line.Id });
                        ViewData["DeleteConfirm"] = "Delete this receipt line item?";
                        ViewData["HtmxTarget"] = "closest tr";
                    }
                    <partial name="_RowActions" />
                </td>
            </tr>
        }
    }
</tbody>
