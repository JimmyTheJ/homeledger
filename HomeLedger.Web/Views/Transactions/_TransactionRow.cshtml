@model HomeLedger.Core.Entities.Transaction
@using HomeLedger.Core.Utilities
@{
    var segments = NotesFormatter.ParseSegments(Model.Notes ?? "");
}
<tr>
    <td>@HomeLedgerFormats.FormatDate(Model.Date)</td>
    <td>@Model.Category?.Name</td>
    <td>@Model.LedgerEntity?.Name</td>
    <td class="@(Model.Amount >= 0 ? "positive" : "negative")">@Model.Amount.ToString("C")</td>
    <td class="notes-cell">
        @if (string.IsNullOrWhiteSpace(Model.Notes))
        {
            <span class="muted">—</span>
        }
        else if (segments.Count <= 1)
        {
            @Model.Notes
        }
        else
        {
            <ul class="note-segments">
                @foreach (var segment in segments)
                {
                    <li>@segment.</li>
                }
            </ul>
        }
    </td>
    <td>
        <a href="@Url.Action("Edit", "Transactions", new { id = Model.Id })">Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline"
              hx-post="@Url.Action("Delete", "Transactions", new { id = Model.Id })"
              hx-target="closest tr" hx-swap="outerHTML"
              hx-confirm="Delete this transaction?">
            @Html.AntiForgeryToken()
            <button type="submit" class="outline secondary">Delete</button>
        </form>
    </td>
</tr>
