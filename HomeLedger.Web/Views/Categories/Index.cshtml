@model IReadOnlyList<HomeLedger.Core.Entities.CategoryGroup>
@{
    ViewData["Title"] = "Categories";
    var scopeEntityId = ViewBag.ScopeEntityId as int?;
    var scopeLabel = ViewBag.ScopeLabel as string ?? "Global baseline";
    var entities = ViewBag.Entities as IEnumerable<HomeLedger.Core.Entities.LedgerEntity> ?? [];
}

<div class="page-head">
    <div>
        <h1>Categories</h1>
        <p class="page-subtitle">Editing <strong>@scopeLabel</strong></p>
    </div>
    <div class="page-head-actions">
        <a role="button" asp-action="CreateGroup" asp-route-entityId="@scopeEntityId">
            <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg> Group
        </a>
        <a role="button" class="secondary" asp-action="CreateCategory" asp-route-entityId="@scopeEntityId">
            <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg> Category
        </a>
    </div>
</div>

<form method="get" class="toolbar">
    <label>
        Scope
        <select name="entityId" onchange="this.form.submit()">
            <option value="">Global baseline (all entities)</option>
            @foreach (var entity in entities)
            {
                <option value="@entity.Id" selected="@(scopeEntityId == entity.Id)">@entity.Name — entity extensions</option>
            }
        </select>
    </label>
</form>

<details>
    <summary>How scopes work</summary>
    <p>
        <strong>Global baseline</strong> uses an industry-style personal finance taxonomy (~20 groups, ~90 categories)
        aligned with common apps (YNAB/Mint-style groupings) and CFPB spending categories.
    </p>
    <p>
        <strong>Entity extensions</strong> add groups/categories only for that profile
        (e.g. a business entity might add "Office Supplies" without cluttering the global list).
    </p>
</details>

@foreach (var group in Model)
{
    <section>
        <div class="page-head inline">
            <h2>
                @group.Name
                @if (!group.IsActive) { <small class="muted">(inactive)</small> }
            </h2>
            <div class="page-head-actions">
                @{
                    ViewData["EditUrl"] = Url.Action("EditGroup", new { id = group.Id });
                    ViewData["PrimaryLabel"] = "Edit group";
                    ViewData["DeleteUrl"] = Url.Action("DeleteGroup", new { id = group.Id });
                    ViewData["DeleteLabel"] = "Remove group";
                    ViewData["DeleteConfirm"] = "Remove this group and its categories?";
                    ViewData["UseHtmxDelete"] = false;
                }
                <partial name="_RowActions" />
            </div>
        </div>

        <figure class="table-narrow">
            <table>
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in group.Categories.OrderBy(c => c.SortOrder))
                    {
                        <tr class="@(!category.IsActive ? "inactive-row" : "")">
                            <td>@category.Name</td>
                            <td class="muted">@(category.IsIncome ? "Income" : "Expense")</td>
                            <td class="actions-cell">
                                @{
                                    ViewData["EditUrl"] = Url.Action("EditCategory", new { id = category.Id });
                                    ViewData["PrimaryLabel"] = "Edit category";
                                    ViewData["DeleteUrl"] = Url.Action("DeleteCategory", new { id = category.Id });
                                    ViewData["DeleteLabel"] = "Remove category";
                                    ViewData["DeleteConfirm"] = "Remove this category?";
                                }
                                <partial name="_RowActions" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </figure>

        <p><a asp-action="CreateCategory" asp-route-entityId="@scopeEntityId" asp-route-groupId="@group.Id">Add category to @group.Name</a></p>
    </section>
}

@if (!Model.Any())
{
    <p class="empty-state">No groups in this scope yet. <a asp-action="CreateGroup" asp-route-entityId="@scopeEntityId">Create one</a>.</p>
}
