@model IReadOnlyList<HomeLedger.Core.Entities.CategoryGroup>
@{
    ViewData["Title"] = "Categories";
    var scopeEntityId = ViewBag.ScopeEntityId as int?;
    var scopeLabel = ViewBag.ScopeLabel as string ?? "Global baseline";
    var entities = ViewBag.Entities as IEnumerable<HomeLedger.Core.Entities.LedgerEntity> ?? [];
}

<hgroup>
    <h1>Categories</h1>
    <p>Editing: <strong>@scopeLabel</strong></p>
</hgroup>

<form method="get" class="grid">
    <label>
        Scope
        <select name="entityId" onchange="this.form.submit()">
            <option value="">Global baseline (all entities)</option>
            @foreach (var entity in entities)
            {
                <option value="@entity.Id" selected="@(scopeEntityId == entity.Id)">@entity.Name — entity extensions</option>
            }
        </select>
    </label>
</form>

<p class="grid">
    <a role="button" asp-action="CreateGroup" asp-route-entityId="@scopeEntityId">Add group</a>
    <a role="button" class="secondary" asp-action="CreateCategory" asp-route-entityId="@scopeEntityId">Add category</a>
</p>

<article>
    <header>How scopes work</header>
    <p>
        <strong>Global baseline</strong> uses an industry-style personal finance taxonomy (~20 groups, ~90 categories)
        aligned with common apps (YNAB/Mint-style groupings) and CFPB spending categories — broader than a one-screen spreadsheet,
        because the web UI does not need to fit everything in one row.
    </p>
    <p>
        <strong>Entity extensions</strong> add groups/categories only for that profile
        (e.g. a business entity might add "Office Supplies" without cluttering the global list).
        Your old spreadsheet columns (Groceries, Cats, SIN, etc.) map into these finer categories — e.g. Cats → Pets, Eating Out → Restaurants & Takeout.
    </p>
</article>

@foreach (var group in Model)
{
    <section>
        <hgroup>
            <h2>
                @group.Name
                @if (!group.IsActive) { <small>(inactive)</small> }
            </h2>
            <p>
                <a asp-action="EditGroup" asp-route-id="@group.Id">Edit group</a>
                <form asp-action="DeleteGroup" asp-route-id="@group.Id" method="post" style="display:inline"
                      onsubmit="return confirm('Remove this group and its categories?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="outline secondary">Remove</button>
                </form>
            </p>
        </hgroup>

        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in group.Categories.OrderBy(c => c.SortOrder))
                {
                    <tr class="@(!category.IsActive ? "inactive-row" : "")">
                        <td>@category.Name</td>
                        <td>@(category.IsIncome ? "Income" : "Expense")</td>
                        <td>
                            <a asp-action="EditCategory" asp-route-id="@category.Id">Edit</a>
                            <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Remove this category?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="outline secondary">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p><a asp-action="CreateCategory" asp-route-entityId="@scopeEntityId" asp-route-groupId="@group.Id">Add category to @group.Name</a></p>
    </section>
}

@if (!Model.Any())
{
    <p>No groups in this scope yet. <a asp-action="CreateGroup" asp-route-entityId="@scopeEntityId">Create one</a>.</p>
}
