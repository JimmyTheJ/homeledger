@model HomeLedger.Core.Configuration.LlmSettings
@using HomeLedger.Core.Configuration
@using HomeLedger.Infrastructure.Llm
@{
    ViewData["Title"] = "Settings";
    var provider = Model.ResolvedProvider;
    var health = ViewBag.LlmHealth as LlmHealthReport;
}

<h1>Settings</h1>

<section>
    <h2>LLM configuration</h2>
    <p>Configure via <code>.env</code> (Docker) or <code>appsettings.json</code> / environment variables. Changes require a restart.</p>

    <table>
        <tbody>
            <tr><th>Enabled</th><td>@(Model.Enabled ? "Yes" : "No")</td></tr>
            <tr><th>Provider</th><td>@provider</td></tr>
            <tr><th>Base URL</th><td>@Model.BaseUrl</td></tr>
            <tr><th>Text model</th><td>@Model.DefaultModel</td></tr>
            <tr><th>Vision model</th><td>@Model.ResolvedVisionModel</td></tr>
            <tr><th>Categorization</th><td>@(Model.UseForCategorization ? "Yes" : "No")</td></tr>
            <tr><th>Import classification</th><td>@(Model.UseForImportClassification ? "Yes" : "No")</td></tr>
            <tr><th>PDF statement import</th><td>@(Model.UseForStatementImport ? "Yes" : "No")</td></tr>
            <tr><th>Receipt image import</th><td>@(Model.UseForReceiptImport ? "Yes" : "No")</td></tr>
            <tr><th>Max PDF pages</th><td>@Model.MaxPdfPages</td></tr>
            <tr><th>Max receipt images</th><td>@Model.MaxReceiptImages</td></tr>
            <tr><th>API key set</th><td>@(string.IsNullOrWhiteSpace(Model.ApiKey) ? "No" : "Yes (hidden)")</td></tr>
            <tr><th>Local/private endpoint</th><td>@(Model.HasEffectiveApiAccess() && string.IsNullOrWhiteSpace(Model.ApiKey) ? "Yes (keyless OK)" : Model.HasEffectiveApiAccess() ? "Yes" : "No")</td></tr>
        </tbody>
    </table>
</section>

@if (health is not null)
{
    <partial name="_LlmHealthStatus" model="health" />
}

<section>
    <h2>PDF statement import</h2>
    <p>
        PDF uploads on the Import page are rendered to images and sent to the configured vision model.
        Extracted lines flow through the same review, categorization, and deduplication pipeline as CSV imports.
        Cloud vision models (GPT-4o, Claude Sonnet, Gemini Flash) work best; local models may struggle on dense statements.
    </p>
</section>

<section>
    <h2>Receipt image import</h2>
    <p>
        Upload one or more receipt photos on the Import page. Each image is sent to the vision model to extract
        merchant, date, and amount. Extracted rows use the same review workflow as CSV and PDF imports.
        Works with local Ollama vision models (e.g. qwen2.5vl) or cloud APIs (OpenAI, Anthropic, Gemini).
    </p>
</section>

<section>
    <h2>Database</h2>
    @{
        var dbProvider = (HomeLedger.Core.Configuration.DatabaseProvider)(ViewBag.DatabaseProvider ?? HomeLedger.Core.Configuration.DatabaseProvider.Sqlite);
    }
    @if (dbProvider == HomeLedger.Core.Configuration.DatabaseProvider.Postgres)
    {
        <p>Provider: <strong>PostgreSQL</strong> (configured via <code>Database:Provider</code> and <code>Database:ConnectionString</code>).</p>
    }
    else
    {
        <p>Provider: <strong>SQLite</strong> &mdash; file at <code>data/homeledger.db</code> (configurable via <code>Database:Provider</code> and <code>Database:ConnectionString</code>).</p>
    }
</section>
