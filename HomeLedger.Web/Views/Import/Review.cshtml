@using HomeLedger.Core.Import
@model HomeLedger.Web.Models.ImportReviewModel
@{
    ViewData["Title"] = "Review import";
    var progress = Model.TotalCount - Model.PendingCount;
}

<hgroup>
    <h1>Review import</h1>
    <p>Entry @(progress + 1) of @Model.TotalCount — @Model.PendingCount remaining</p>
</hgroup>

@if (Model.Batch is not null)
{
    <partial name="_ImportAccountSummary" model="Model.Batch" />
    <partial name="_ImportLlmSummary" model="Model.Batch" />
}

@if (Model.Item is not null)
{
    <partial name="_ValidationErrors" />

    @if (!string.IsNullOrWhiteSpace(Model.Item.SuggestedSkipReason))
    {
        <article class="alert-warning">
            <strong>Suggested skip:</strong> @ImportSkipReasons.Describe(Model.Item.SuggestedSkipReason)
            <p>This row looks like a transfer or non-expense entry based on your import profile. You can skip it or import anyway if you disagree.</p>
        </article>
    }

    <article>
        <header>Bank description</header>
        <p><strong>@Model.Item.Description</strong></p>
        @if (Model.Item.SuggestedCategory is not null)
        {
            <small>
                Suggested: @Model.Item.SuggestedCategory.Name
                @if (Model.Item.SuggestionSource == "llm")
                {
                    <text> (AI)</text>
                }
                else if (Model.Item.SuggestionSource == "rule")
                {
                    <text> (rule)</text>
                }
                else if (Model.Item.SuggestionSource == "history")
                {
                    <text> (past transaction)</text>
                }
            </small>
        }
    </article>

    <form asp-action="Accept" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="batchId" value="@Model.BatchId" />

        <partial name="_TransactionFields" model="Model.Form" />

        <div class="grid">
            <button type="submit">@(Model.Item.SuggestedSkipReason is not null ? "Import anyway" : "Confirm & next")</button>
        </div>
    </form>

    <form asp-action="Skip" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="batchId" value="@Model.BatchId" />
        <input type="hidden" name="itemId" value="@Model.Item.Id" />
        <button type="submit" class="outline secondary">
            @(Model.Item.SuggestedSkipReason is not null ? "Skip (recommended)" : "Skip this entry")
        </button>
    </form>

    <p>
        <form asp-action="Delete" asp-route-id="@Model.BatchId" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="outline secondary" onclick="return confirm('Delete this incomplete import? Transactions already confirmed will be kept.')">Delete entire import</button>
        </form>
    </p>
}
