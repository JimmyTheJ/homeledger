@using HomeLedger.Core.Utilities
@using HomeLedger.Core.Entities
@using HomeLedger.Core.Configuration
@using HomeLedger.Core.Import
@using HomeLedger.Infrastructure.Import
@model HomeLedger.Web.Models.ImportUploadModel
@using HomeLedger.Infrastructure.Llm
@using HomeLedger.Web.Extensions
@{
    ViewData["Title"] = "Import";
    ViewData["UseHtmxDelete"] = false;
    var batches = ViewBag.Batches as IEnumerable<ImportBatch> ?? [];
    var queue = ViewBag.ReceiptQueue as ReceiptQueueModel ?? new ReceiptQueueModel();
    var llmHealth = ViewBag.LlmHealth as LlmHealthReport;
    var inbox = ViewBag.ReceiptInbox as ReceiptInboxSettings ?? new ReceiptInboxSettings();
    var inboxReady = ViewBag.ReceiptInboxReady as bool? ?? false;
    var receiptJobs = ViewBag.ReceiptImportJobs as IReadOnlyList<ReceiptImportJobSnapshot> ?? [];
    var receiptAccept = "image/jpeg,image/png,image/webp,image/gif,image/bmp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.gif,.bmp,.heic,.heif";
    var hasReceiptWork = queue.Current is not null;
}

<hgroup>
    <h1>Import</h1>
    <p>CSV, PDF, or receipt photos. AI extraction runs in the background.</p>
</hgroup>

@if (llmHealth is not null)
{
    var pdfReady = llmHealth.Features.FirstOrDefault(f => f.Feature == "PDF statement import");
    var receiptReady = llmHealth.Features.FirstOrDefault(f => f.Feature == "Receipt image import");
    if (llmHealth.GlobalEnabled && pdfReady is { EffectiveEnabled: false })
    {
        <article class="alert-warning">
            <strong>PDF import unavailable:</strong> @(pdfReady.DisabledReason ?? "LLM is not ready.")
            <a asp-controller="Settings" asp-action="Index" asp-route-check="true">Settings</a>
        </article>
    }
    if (llmHealth.GlobalEnabled && receiptReady is { EffectiveEnabled: false })
    {
        <article class="alert-warning">
            <strong>Receipt import unavailable:</strong> @(receiptReady.DisabledReason ?? "LLM is not ready.")
            <a asp-controller="Settings" asp-action="Index" asp-route-check="true">Settings</a>
        </article>
    }
}

@await Html.PartialAsync("_ReceiptQueue", queue)
@await Html.PartialAsync("_ReceiptImportJobs", receiptJobs)

<article id="import-busy" class="notice" hidden aria-live="polite">
    <p id="import-busy-message">Working…</p>
    <progress></progress>
</article>

@if (hasReceiptWork)
{
    <details class="import-upload-details">
        <summary>Upload another file</summary>
        <partial name="_ImportUploadForm" model="Model" />
    </details>
}
else
{
    <partial name="_ImportUploadForm" model="Model" />
}

@if (inbox.Enabled)
{
    <details>
        <summary>Receipt inbox folder</summary>
        @if (inboxReady)
        {
            <p>
                Drop images into <code>@inbox.WatchPath</code>, or
                <button type="button" class="outline" onclick="document.getElementById('receipt-inbox-dialog').showModal()">upload here</button>.
                Processed automatically.
            </p>
            <dialog id="receipt-inbox-dialog">
                <article>
                    <header>
                        <button type="button" aria-label="Close" rel="prev" class="secondary"
                                onclick="document.getElementById('receipt-inbox-dialog').close()"></button>
                        <h3>Upload to inbox</h3>
                    </header>
                    <form asp-action="UploadToInbox" method="post" enctype="multipart/form-data"
                          data-busy-submit data-busy-message="Uploading…">
                        @Html.AntiForgeryToken()
                        <label>
                            Receipt images
                            <input name="receiptImages" type="file" accept="@receiptAccept" multiple required />
                        </label>
                        <footer>
                            <button type="submit">Upload</button>
                            <button type="button" class="secondary"
                                    onclick="document.getElementById('receipt-inbox-dialog').close()">Cancel</button>
                        </footer>
                    </form>
                </article>
            </dialog>
        }
        else
        {
            <p>
                Set <code>ReceiptInbox:AccountId</code> and <code>ReceiptInbox:LedgerEntityId</code>
                in <a asp-controller="Settings" asp-action="Index">Settings</a>.
            </p>
        }
    </details>
}

@if (batches.Any())
{
    <section>
        <h2>Recent imports</h2>
        <table>
            <thead>
                <tr>
                    <th>File</th>
                    <th>Account</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var batch in batches)
                {
                    <tr>
                        <td>@batch.FileName</td>
                        <td>
                            @if (batch.Account is not null)
                            {
                                @AccountDisplay.FormatLabel(batch.Account)
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td>@batch.Status</td>
                        <td>@HomeLedgerFormats.FormatDate(DateOnly.FromDateTime(batch.CreatedAt.ToLocalTime())) @batch.CreatedAt.ToLocalTime().ToString("HH:mm")</td>
                        <td class="actions-cell">
                            @{
                                if (batch.Status == ImportBatchStatus.Reviewing
                                    && batch.ImportKind is ImportKind.Receipt or ImportKind.WatchedReceipt)
                                {
                                    ViewData["EditUrl"] = Url.Action("Index", new { receipt = batch.Id });
                                    ViewData["PrimaryLabel"] = "Confirm";
                                    ViewData["DeleteUrl"] = Url.Action("Delete", new { id = batch.Id });
                                    ViewData["DeleteConfirm"] = "Delete this receipt import? Saved items will be kept.";
                                }
                                else if (batch.Status == ImportBatchStatus.Reviewing)
                                {
                                    ViewData["EditUrl"] = Url.Action("Review", new { id = batch.Id });
                                    ViewData["PrimaryLabel"] = "Continue";
                                    ViewData["DeleteUrl"] = Url.Action("Delete", new { id = batch.Id });
                                    ViewData["DeleteConfirm"] = "Delete this incomplete import? Saved transactions from partial review will be kept.";
                                }
                                else if (batch.Status == ImportBatchStatus.Pending)
                                {
                                    ViewData["EditUrl"] = null;
                                    ViewData["PrimaryLabel"] = null;
                                    ViewData["DeleteUrl"] = Url.Action("Delete", new { id = batch.Id });
                                    ViewData["DeleteConfirm"] = "Delete this import?";
                                }
                                else
                                {
                                    ViewData["EditUrl"] = Url.Action("Complete", new { id = batch.Id });
                                    ViewData["PrimaryLabel"] = "View";
                                    ViewData["DeleteUrl"] = null;
                                    ViewData["DeleteConfirm"] = null;
                                }
                            }
                            <partial name="_RowActions" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
