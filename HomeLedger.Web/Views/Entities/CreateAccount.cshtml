@model HomeLedger.Core.Entities.Account
@{
    ViewData["Title"] = "Add account";
}

<h1>Add account</h1>

<form asp-action="CreateAccount" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LedgerEntityId" />

    <label>
        Name
        <input asp-for="Name" required />
    </label>
    <label>
        Institution
        <input asp-for="Institution" placeholder="Bank name" />
    </label>
    <label>
        Last 4 digits
        <input asp-for="AccountNumberLast4" maxlength="4" />
    </label>
    <button type="submit">Save</button>
</form>
