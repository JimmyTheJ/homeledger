@model HomeLedger.Core.Entities.Account
@using HomeLedger.Core.Entities
@{
    ViewData["Title"] = "Edit account";
}

<h1>Edit account</h1>

<form asp-action="EditAccount" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LedgerEntityId" />

    <label>
        Name
        <input asp-for="Name" required />
    </label>
    <label>
        Account type
        <select asp-for="Kind" asp-items="ViewBag.AccountKinds"></select>
    </label>
    <label>
        Institution
        <input asp-for="Institution" placeholder="Bank name" />
    </label>
    <label>
        Last 4 digits
        <input asp-for="AccountNumberLast4" maxlength="4" />
    </label>
    <label>
        Import skip profile (optional)
        <select asp-for="ImportProfileId" asp-items="ViewBag.ImportProfiles">
            <option value="">Use entity default</option>
        </select>
    </label>
    <button type="submit">Save</button>
</form>

<p><a asp-action="Index">Back to entities</a></p>
