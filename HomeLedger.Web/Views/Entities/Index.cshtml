@model IEnumerable<HomeLedger.Core.Entities.LedgerEntity>
@{
    ViewData["Title"] = "Entities & accounts";
}

<hgroup>
    <h1>Entities &amp; accounts</h1>
    <p>Track finances separately for household members or accounts.</p>
    <p>
        <a role="button" asp-action="Create">Add entity</a>
        <a role="button" class="secondary" asp-controller="ImportProfiles" asp-action="Index">Import skip profiles</a>
    </p>
</hgroup>

@foreach (var entity in Model)
{
    <article>
        <header>@entity.Name</header>
        <ul>
            @foreach (var account in entity.Accounts)
            {
                <li>
                    @account.Name @(account.Institution is not null ? $"({account.Institution})" : "")
                    @if (account.ImportProfile is not null)
                    {
                        <small> — profile: @account.ImportProfile.Name</small>
                    }
                    <a asp-action="EditAccount" asp-route-id="@account.Id">Edit</a>
                </li>
            }
        </ul>
        <footer>
            <a asp-action="CreateAccount" asp-route-entityId="@entity.Id">Add account</a>
            <a asp-controller="ImportProfiles" asp-action="Index" asp-route-entityId="@entity.Id">Import profiles</a>
        </footer>
    </article>
}
