@model IEnumerable<Ledger.Core.Entities.Transaction>
@{
    ViewData["Title"] = "Transactions";
}

<hgroup>
    <h1>Transactions</h1>
    <p><a role="button" asp-action="Create">Add transaction</a></p>
</hgroup>

<form method="get" class="grid">
    <label>From <input type="date" name="from" value="@ViewBag.From" /></label>
    <label>To <input type="date" name="to" value="@ViewBag.To" /></label>
    <label>
        Category
        <select name="categoryId" asp-items="ViewBag.Categories">
            <option value="">All</option>
        </select>
    </label>
    <label>
        Entity
        <select name="entityId" asp-items="ViewBag.Entities">
            <option value="">All</option>
        </select>
    </label>
    <button type="submit">Filter</button>
</form>

<figure>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Entity</th>
                <th>Amount</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="transaction-rows">
            @foreach (var t in Model)
            {
                <partial name="_TransactionRow" model="t" />
            }
        </tbody>
    </table>
</figure>
