@model Ledger.Web.Models.TransactionFormModel

<label>
    Date
    <input asp-for="Date" type="date" required />
</label>
<label>
    Amount
    <input asp-for="Amount" type="number" step="0.01" required />
    <small>Positive = income, negative = expense</small>
</label>

<label>
    Category
    <select asp-for="CategoryId" asp-items="ViewBag.Categories" required></select>
</label>

<div class="grid">
    <label>
        Entity
        <select asp-for="LedgerEntityId" asp-items="ViewBag.Entities" required></select>
    </label>
    <label>
        Account
        <select asp-for="AccountId" asp-items="ViewBag.Accounts">
            <option value="">—</option>
        </select>
    </label>
</div>

<label>
    Notes
    <textarea asp-for="Notes" rows="4" placeholder="What was this for? Separate multiple items with periods."></textarea>
    <small>Multiple items? End each with a period — they'll display as a list.</small>
</label>
