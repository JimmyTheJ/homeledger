@{
    ViewData["Title"] = "Export";
}

<hgroup>
    <h1>Export ledger</h1>
    <p>
        Download a lossless CSV backup of entities, accounts, categories, budgets, and transactions.
        The same file can be re-imported from the Import page.
    </p>
</hgroup>

<p>
    <a role="button" asp-action="Download">Download ledger export</a>
    <a role="button" class="secondary" asp-controller="Import" asp-action="Index">Go to import</a>
</p>

<section>
    <h2>Format</h2>
    <p>
        Files use the <code>ledger-export-v1</code> format: one CSV with a <code>RecordType</code> column
        for each row kind (<code>entity</code>, <code>account</code>, <code>category_group</code>,
        <code>category</code>, <code>budget</code>, <code>transaction</code>).
    </p>
    <p>Re-importing merges by name (upsert) and skips duplicate transactions automatically.</p>
</section>
