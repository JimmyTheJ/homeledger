@model Ledger.Web.Models.BudgetLimitFormModel
@{
    ViewData["Title"] = "Add budget limit";
}

<h1>Add budget limit</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <label>
        Category
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" required></select>
    </label>

    <label>
        Entity (optional)
        <select asp-for="LedgerEntityId" asp-items="ViewBag.Entities">
            <option value="">All entities</option>
        </select>
    </label>

    <div class="grid">
        <label>
            Limit amount
            <input asp-for="LimitAmount" type="number" step="0.01" min="0.01" required />
        </label>
        <label>
            Warning at %
            <input asp-for="WarningThresholdPercent" type="number" min="1" max="100" />
        </label>
    </div>

    <label>
        Period
        <select asp-for="Period" asp-items="Html.GetEnumSelectList<Ledger.Core.Entities.BudgetPeriod>()"></select>
    </label>

    <div class="grid">
        <label>
            Custom start
            <input asp-for="CustomStartDate" type="text" placeholder="yyyy/MM/dd" />
        </label>
        <label>
            Custom end
            <input asp-for="CustomEndDate" type="text" placeholder="yyyy/MM/dd" />
        </label>
    </div>

    <button type="submit">Save</button>
</form>
