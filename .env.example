# Copy to .env on each server and customize:
#   cp .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution in docker-compose.yml.
# Restart after changes: docker compose up -d

# --- Database ---
# Host directory bind-mounted to /app/data in the container (SQLite file lives here).
HOMELEDGER_DATA_DIR=./data
# Provider: "Sqlite" (default, file-backed, smallest footprint) or "Postgres".
DB_PROVIDER=Sqlite
# SQLite (default):
DB_CONNECTION_STRING=Data Source=/app/data/homeledger.db
# PostgreSQL example (uncomment and set DB_PROVIDER=Postgres):
# DB_PROVIDER=Postgres
# DB_CONNECTION_STRING=Host=db;Port=5432;Database=homeledger;Username=homeledger;Password=change-me

# --- LLM (Ollama on a shared Docker network) ---
LLM_ENABLED=true
LLM_PROVIDER=OpenAiCompatible
LLM_BASE_URL=http://aiweb_ollama:11434/v1
# Dummy value is fine for Ollama; required for PDF/receipt import / import-classification when BaseUrl is not localhost
LLM_API_KEY=ollama
LLM_DEFAULT_MODEL=phi4:latest
LLM_VISION_MODEL=qwen2.5vl:7b

LLM_USE_FOR_CATEGORIZATION=true
LLM_USE_FOR_NOTES_CLEANUP=false
LLM_USE_FOR_STATEMENT_IMPORT=true
LLM_USE_FOR_RECEIPT_IMPORT=true
LLM_USE_FOR_IMPORT_CLASSIFICATION=true
LLM_MAX_PDF_PAGES=30
LLM_MAX_RECEIPT_IMAGES=20

# --- Local dev without .env (optional overrides) ---
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_BASE_URL=http://localhost:11434/v1
